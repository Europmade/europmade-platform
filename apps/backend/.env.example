# apps/backend — environment-variabelen (Medusa v2)
# Kopieer naar .env voor lokale ontwikkeling (Medusa laadt .env, geen .env.local).
#
# Fase 1 (S3-00-07): uitsluitend scaffold/basisconfiguratie. Geen Customer-,
# Product- of overige custom-module-configuratie in dit bestand.

# ---- Database (gedeelde lokale PostgreSQL, zie root docker-compose.yml) ----
# Zelfde instantie/database als de root .env — geen apart schema per app.
DATABASE_URL=postgres://europmade:europmade_local_dev@localhost:5432/europmade

# ---- CORS ----
# Store API: aangeroepen door apps/web (publieke frontend).
STORE_CORS=http://localhost:3000
# Admin API: aangeroepen door Medusa's eigen Admin-dashboard (dev-server op 5173,
# gebundeld op 9000) — zie 08-technical-blueprint/11-medusa-architecture.md §4.
# apps/admin (EuropMade Operations Platform) is een apart, EuropMade-specifiek
# platform en roept de Admin-API server-side aan, niet vanuit de browser.
ADMIN_CORS=http://localhost:5173,http://localhost:9000,http://localhost:3001
# Auth-endpoints worden door zowel Store- als Admin-clients gebruikt.
AUTH_CORS=http://localhost:3000,http://localhost:5173,http://localhost:9000,http://localhost:3001

# ---- Secrets (nooit hergebruiken — lokaal genereren) ----
# Genereer bijvoorbeeld met: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
COOKIE_SECRET=
# Vereist zodra Auth MFA (two_factor_enabled, zie 11-medusa-architecture.md §5) actief wordt.
AUTH_MFA_ENCRYPTION_KEY=

# ---- Redis (optioneel) ----
# Niet vereist in Fase 1: zonder REDIS_URL gebruikt Medusa de in-memory
# Event Bus/Workflow Engine/Cache-implementaties (voldoende voor lokale ontwikkeling
# met één instantie). Pas invullen zodra een custom module dit expliciet nodig heeft.
# REDIS_URL=redis://localhost:6379

# ---- RBAC (S3-01-04, uitsluitend gedocumenteerd — bewust nog niet actief) ----
# Medusa's ingebouwde RBAC-module (rollen/policies, "<resource>:<operation>",
# rolhiërarchie) dekt uitsluitend Beheerder-zijdige (Admin-API/`user`-actor)
# autorisatie — zie implementatierapport S3-01-04. Vereist na inschakelen een
# database-migratie (`medusa db:migrate`) vóórdat de backend weer start, en het
# toewijzen van de "Super Admin"-rol aan bestaande Admin-gebruikers. Bewust niet
# in .env gezet: activeren is een expliciete, aparte beslissing, geen sluipende
# gedragswijziging via deze commit.
# MEDUSA_FF_RBAC=true
# MEDUSA_FF_RBAC_FILTER_FIELDS=true

# ---- Overig ----
MEDUSA_ADMIN_ONBOARDING_TYPE=default

# ---- Product Cloud translations (ADR-0038 / ADR-0039) ----
# Default: none — architecture + enqueue works; no fake machine translations.
# PRODUCT_CLOUD_TRANSLATION_PROVIDER=none
# DeepL (free or pro endpoint):
# PRODUCT_CLOUD_TRANSLATION_PROVIDER=deepl
# PRODUCT_CLOUD_TRANSLATION_API_KEY=
# Optional override (default: https://api-free.deepl.com/v2/translate):
# PRODUCT_CLOUD_TRANSLATION_BASE_URL=https://api.deepl.com/v2/translate
#
# Active MVP languages: nl, en, fr, de (see languages.ts). Storefront reads
# only status=Gepubliceerd; never calls the provider on page-load.
