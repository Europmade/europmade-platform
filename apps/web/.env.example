# apps/web — environment-variabelen
# Kopieer naar .env.local voor lokale ontwikkeling.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# URL van de Medusa-backend (apps/backend).
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# Publiceerbare API-sleutel van de Medusa Store-API (Admin-dashboard → Instellingen →
# Publiceerbare API-sleutels). Vereist door elke /store/*-aanroep, waaronder het
# aanmaken van het Customer-record na registratie (S3-01-05).
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# Product Cloud machine translation credentials live on the backend only
# (PRODUCT_CLOUD_TRANSLATION_PROVIDER / PRODUCT_CLOUD_TRANSLATION_API_KEY).
# See apps/backend/.env.example and ADR-0038.

# UAT / development: show empty pc_category rows in the storefront nav.
# Default (unset/false) = only categories with published products (customer view).
# NEXT_PUBLIC_STOREFRONT_SHOW_EMPTY_CATEGORIES=true
#
# Alternative without restart (dev/UAT): open any storefront URL with
# ?show_empty_nav=1  (cookie em_show_empty_nav=1) or ?show_empty_nav=0 to clear.
