# EuropMade — gedeelde environment-variabelen (root)
# Kopieer dit bestand naar .env en vul lokale waarden in.
# Per-app-specifieke variabelen staan in apps/*/.env.example — dit bestand bevat
# uitsluitend wat gedeeld wordt tussen apps (met name de lokale PostgreSQL-instantie
# uit docker-compose.yml).

# ---- PostgreSQL (lokale ontwikkeling via Docker Compose) ----
POSTGRES_USER=europmade
POSTGRES_PASSWORD=europmade_local_dev
POSTGRES_DB=europmade
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Samengestelde connection string, zoals gebruikt door apps/backend
DATABASE_URL=postgres://europmade:europmade_local_dev@localhost:5432/europmade

# ---- Node ----
NODE_ENV=development
